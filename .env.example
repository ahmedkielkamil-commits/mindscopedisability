# Service Principal used to read Key Vault and call the Azure AI Foundry agent.
# Vite fetches the secrets below at dev/build time and inlines them in the page.
# Restart Vite when the Azure token expires (about an hour).
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_KEYVAULT_URI=https://your-vault-name.vault.azure.net/

# Stored in Key Vault, not here:
#   agentendpoint  Foundry project URL (…/api/projects/<project-name>)
#   agentname      Foundry agent name
#   tavilykey      Tavily API key
#   googleplaces   Google Places API key
